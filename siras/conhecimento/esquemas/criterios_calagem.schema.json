{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/siras/esquemas/criterios_calagem.schema.json",
  "title": "Critérios de calagem por cultura e manejo",
  "type": "object",
  "required": [
    "descricao",
    "fonte",
    "criterios"
  ],
  "properties": {
    "descricao": { "type": "string" },
    "fonte": {
      "type": "object",
      "required": [
        "manual",
        "tabelas",
        "paginas",
        "extraido_do_pdf_em",
        "conferido_por_autor_em",
        "conferido_operadores_em",
        "nota_conferencia"
      ],
      "properties": {
        "manual": { "type": "string" },
        "tabelas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paginas": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "extraido_do_pdf_em": { "type": "string" },
        "conferido_por_autor_em": { "type": "string" },
        "conferido_operadores_em": { "type": "string" },
        "nota_conferencia": { "type": "string" }
      },
      "additionalProperties": true
    },
    "criterios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "grupo",
          "sistema_manejo",
          "condicao_area",
          "amostragem_cm",
          "ph_referencia",
          "decisao",
          "dose",
          "modo_aplicacao",
          "fonte",
          "notas"
        ],
        "properties": {
          "id": { "type": "string" },
          "grupo": { "type": "string" },
          "sistema_manejo": { "type": "string" },
          "condicao_area": { "type": "string" },
          "amostragem_cm": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          },
          "ph_referencia": {
            "type": ["number", "null"]
          },
          "decisao": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": { "type": "string" },
              "ph": { "type": "number" },
              "v": { "type": "number" },
              "saturacao_al_maior_igual": { "type": "number" },
              "nao_aplicar_se": { "type": "string" }
            },
            "additionalProperties": true
          },
          "dose": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": { "type": "string" },
              "fator": { "type": "number" },
              "ph_alvo": { "type": "number" },
              "limite_t_ha": { "type": "number" },
              "usar_smp_medio_das_camadas": { "type": "boolean" },
              "v_alvo": { "type": "number" }
            },
            "additionalProperties": true
          },
          "modo_aplicacao": { "type": "string" },
          "fonte": { "type": "string" },
          "notas": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
