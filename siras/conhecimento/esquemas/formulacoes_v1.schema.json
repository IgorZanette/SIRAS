{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formulacoes_v1",
  "title": "Catalogo de formulacoes NPK comerciais",
  "description": "Dado de mercado, NAO transcricao do Manual. Cada entrada exige fonte propria em _fonte.",
  "type": "object",
  "required": ["descricao", "aviso", "formulacoes"],
  "properties": {
    "descricao": {"type": "string", "minLength": 1},
    "aviso": {"type": "string", "minLength": 1},
    "unidade": {"type": "string"},
    "criterio_de_escolha": {"type": "string"},
    "atualizado_em": {"type": ["string", "null"]},
    "formulacoes": {
      "type": "array",
      "items": {"$ref": "#/$defs/formulacao"}
    }
  },
  "$defs": {
    "formulacao": {
      "type": "object",
      "required": ["id", "rotulo", "n", "p2o5", "k2o", "_fonte"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Identificador estavel, minusculas sem acento (ex.: 'f-05-20-20')"
        },
        "rotulo": {
          "type": "string",
          "minLength": 1,
          "description": "Como a formulacao aparece no rotulo do produto"
        },
        "n": {"type": "number", "minimum": 0, "maximum": 100},
        "p2o5": {"type": "number", "minimum": 0, "maximum": 100},
        "k2o": {"type": "number", "minimum": 0, "maximum": 100},
        "observacao": {"type": "string"},
        "_fonte": {
          "type": "string",
          "minLength": 1,
          "description": "De onde veio esta entrada. Obrigatorio: e o que separa dado de mercado conferido de numero digitado de memoria."
        }
      }
    }
  }
}
