{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "Interpretação de Potássio por Grupo de Exigência e Faixa de CTC pH 7,0",
  "type": "object",
  "required": ["descricao", "fonte", "unidade", "metodo", "faixas_ctc", "grupos_exigencia", "tabelas"],
  "properties": {
    "descricao": { "type": "string", "minLength": 1 },
    "fonte": {
      "type": "object",
      "required": ["manual", "tabelas", "paginas"],
      "properties": {
        "manual": { "type": "string" },
        "tabelas": { "type": "array", "items": { "type": "string" } },
        "paginas": { "type": "array", "items": { "type": "integer" } },
        "extraido_do_pdf_em": { "type": ["string", "null"] },
        "conferido_por_autor_em": { "type": ["string", "null"] },
        "aviso_operadores": { "type": ["string", "null"] }
      }
    },
    "unidade": { "type": "string" },
    "metodo": { "type": "string" },
    "conversao_mehlich3": {
      "type": "object",
      "properties": {
        "formula": { "type": "string" },
        "fonte": { "type": "string" }
      }
    },
    "depende_de": { "type": "string" },
    "faixas_ctc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["faixa", "de", "ate"],
        "properties": {
          "faixa": { "type": "string" },
          "de": { "type": ["number", "null"] },
          "ate": { "type": ["number", "null"] }
        }
      }
    },
    "grupos_exigencia": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["grupo", "descricao", "tabela"],
        "properties": {
          "grupo": { "type": "string" },
          "descricao": { "type": "string" },
          "tabela": { "type": "string" },
          "culturas": { "type": "array", "items": { "type": "string" } },
          "culturas_texto": { "type": "string" }
        }
      }
    },
    "tabelas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["grupo", "fonte", "por_faixa_ctc"],
        "properties": {
          "grupo": { "type": "string" },
          "fonte": { "type": "string" },
          "por_faixa_ctc": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["faixa_ctc", "faixas"],
              "properties": {
                "faixa_ctc": { "type": "string" },
                "faixas": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["classe", "de", "ate"],
                    "properties": {
                      "classe": { "type": "string" },
                      "de": { "type": ["number", "null"] },
                      "ate": { "type": ["number", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
